{
  "name": "Waitlist Follow-up SLA Alert — 10:00AM Weekdays",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-1",
      "name": "10:00 AM Weekdays",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://bot:8097/waitlist/followups/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        }
      },
      "id": "get-due-1",
      "name": "Get Due Followups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "const entries = $input.first().json.entries || [];\nif (!entries.length) {\n  return [{json: {notify: false, message: '✅ No due waitlist follow-ups.'}}];\n}\nlet msg = '📞 *Waitlist Follow-up SLA Alert*\\n\\n';\nmsg += `Due follow-ups: ${entries.length}\\n\\n`;\nfor (const item of entries.slice(0, 20)) {\n  const f = item.fields || {};\n  const name = `${f.child_first_name || ''} ${f.child_last_name || ''}`.trim() || 'n/a';\n  msg += `🔴 Entry #${item.id} | ${name}\\n`;\n  msg += `Status: ${f.status || 'n/a'}\\n`;\n  msg += `Next follow-up: ${f.next_follow_up_at || 'n/a'}\\n`;\n  if (f.tour_date) msg += `Tour: ${f.tour_date}\\n`;\n  msg += '\\n';\n}\nreturn [{json: {notify: true, message: msg, due_count: entries.length}}];"
      },
      "id": "format-1",
      "name": "Format SLA Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "notify-true",
              "leftValue": "={{$json.notify}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-notify-1",
      "name": "Should Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{$env.TELEGRAM_ALERT_CHAT_ID}}"
            },
            {
              "name": "text",
              "value": "={{$json.message}}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            }
          ]
        }
      },
      "id": "send-telegram-1",
      "name": "Send Waitlist SLA Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 250]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://bot:8097/ops/workflows/heartbeat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { workflow_key: 'waitlist_followup_sla_alert', workflow_name: 'Waitlist Follow-up SLA Alert — 10:00AM Weekdays', status: 'success', ran_at: new Date().toISOString() } }}"
      },
      "id": "heartbeat-1",
      "name": "Record Workflow Heartbeat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "10:00 AM Weekdays": {
      "main": [[{"node": "Get Due Followups", "type": "main", "index": 0}]]
    },
    "Get Due Followups": {
      "main": [[{"node": "Format SLA Alert", "type": "main", "index": 0}]]
    },
    "Format SLA Alert": {
      "main": [[{"node": "Should Notify?", "type": "main", "index": 0}]]
    },
    "Should Notify?": {
      "main": [[{"node": "Send Waitlist SLA Alert", "type": "main", "index": 0}], [{"node": "Record Workflow Heartbeat", "type": "main", "index": 0}]]
    },
    "Send Waitlist SLA Alert": {
      "main": [[{"node": "Record Workflow Heartbeat", "type": "main", "index": 0}]]
    }
  },
  "settings": {"callerPolicy": "workflowsFromSameFolder"},
  "staticData": null,
  "pinData": {},
  "versionId": "1"
}
