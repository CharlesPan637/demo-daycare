{
  "name": "Sanitation Checklist Alert — 1:00PM Weekdays",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 13 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-1",
      "name": "1:00 PM Weekdays",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{`http://bot:8097/compliance/sanitation-checks?date=${new Date().toISOString().slice(0,10)}`}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        }
      },
      "id": "get-checks-1",
      "name": "Get Sanitation Checks (Today)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "const checks = $input.first().json.checks || [];\nif (!checks.length) {\n  return [{json: {notify: true, message: '🧼 *Sanitation Checklist Alert*\\n\\nNo sanitation checks logged today.'}}];\n}\nconst issues = [];\nfor (const item of checks) {\n  const f = item.fields || {};\n  const status = String(f.status || '').toLowerCase();\n  if (status === 'issue' || status === 'skipped') {\n    issues.push({id: item.id, check_area: f.check_area || 'n/a', check_item: f.check_item || 'n/a', status, notes: f.notes || ''});\n  }\n}\nif (!issues.length) {\n  return [{json: {notify: false, message: `✅ Sanitation checks complete. Logged entries: ${checks.length}.`}}];\n}\nlet msg = '🧼 *Sanitation Checklist Alert*\\n\\n';\nmsg += `Flagged checks: ${issues.length}\\n\\n`;\nfor (const row of issues.slice(0, 20)) {\n  msg += `🔴 Check #${row.id} | ${row.check_area}\\n`;\n  msg += `${row.check_item} | status: ${row.status}\\n`;\n  if (row.notes) msg += `${row.notes}\\n`;\n  msg += '\\n';\n}\nreturn [{json: {notify: true, message: msg, issue_count: issues.length}}];"
      },
      "id": "find-issues-1",
      "name": "Find Sanitation Issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "notify-true",
              "leftValue": "={{$json.notify}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-notify-1",
      "name": "Should Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{$env.TELEGRAM_ALERT_CHAT_ID}}"
            },
            {
              "name": "text",
              "value": "={{$json.message}}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            }
          ]
        }
      },
      "id": "send-telegram-1",
      "name": "Send Sanitation Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 250]
    }
  ],
  "connections": {
    "1:00 PM Weekdays": {
      "main": [
        [
          {
            "node": "Get Sanitation Checks (Today)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Sanitation Checks (Today)": {
      "main": [
        [
          {
            "node": "Find Sanitation Issues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Sanitation Issues": {
      "main": [
        [
          {
            "node": "Should Notify?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Notify?": {
      "main": [
        [
          {
            "node": "Send Sanitation Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "callerPolicy": "workflowsFromSameFolder"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "1"
}
