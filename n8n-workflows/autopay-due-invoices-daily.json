{
  "name": "Autopay Due Invoices — 8:00AM Weekdays",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-1",
      "name": "8:00 AM Weekdays",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://bot:8097/billing/invoices?status=issued",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        }
      },
      "id": "get-issued-1",
      "name": "Get Issued Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        220
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://bot:8097/billing/invoices?status=partial",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            }
          ]
        }
      },
      "id": "get-partial-1",
      "name": "Get Partial Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const issued = $input.all()[0]?.json?.invoices || [];\nconst partial = $input.all()[1]?.json?.invoices || [];\nconst invoices = [...issued, ...partial];\nconst today = new Date().toISOString().slice(0, 10);\nconst due = invoices.filter(inv => {\n  const f = inv.fields || {};\n  const dueDate = String(f.due_date || '');\n  const balance = Number(inv.balance || 0);\n  return dueDate && dueDate <= today && balance > 0;\n});\nif (!due.length) {\n  return [{json: {no_due: true, message: `✅ No due invoices for autopay on ${today}.`}}];\n}\nreturn due.map(inv => ({json: {\n  invoice_id: inv.id,\n  due_date: inv.fields?.due_date || '',\n  balance: Number(inv.balance || 0),\n  total_paid: Number(inv.total_paid || 0)\n}}));"
      },
      "id": "select-due-1",
      "name": "Select Due Invoices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-id",
              "leftValue": "={{$json.invoice_id}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-run-1",
      "name": "Has Due Invoice?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{`http://bot:8097/billing/invoices/${$json.invoice_id}/autopay/run`}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "run-autopay-1",
      "name": "Run Invoice Autopay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1050,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json || {});\nif (!rows.length) {\n  return [{json: {notify: false, message: '✅ No due invoices were processed for autopay.'}}];\n}\nlet failed = [];\nlet attempted = 0;\nfor (const row of rows) {\n  const attempts = row.attempts || [];\n  attempted += Number(row.attempt_count || attempts.length || 0);\n  for (const a of attempts) {\n    if (String(a.status || '').toLowerCase() === 'failed') {\n      failed.push({\n        invoice_id: row.invoice_id,\n        party_id: a.party_id,\n        amount: Number(a.amount || 0),\n        error_code: a.error_code || '',\n        error_message: a.error_message || ''\n      });\n    }\n  }\n}\nif (!failed.length) {\n  return [{json: {notify: false, message: `✅ Autopay completed. Attempts: ${attempted}. No failures detected.`}}];\n}\nlet msg = '💳 *Autopay Failure Alert*\\n\\n';\nmsg += `Total attempts: ${attempted}\\n`;\nmsg += `Failed attempts: ${failed.length}\\n\\n`;\nfor (const f of failed.slice(0, 20)) {\n  msg += `🔴 Invoice #${f.invoice_id} | Party #${f.party_id} | $${f.amount.toFixed(2)}\\n`;\n  msg += `Code: ${f.error_code || 'n/a'}\\n`;\n  if (f.error_message) msg += `${f.error_message}\\n`;\n  msg += '\\n';\n}\nreturn [{json: {notify: true, message: msg, failed_count: failed.length, attempted}}];"
      },
      "id": "summarize-1",
      "name": "Summarize Autopay Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "notify-true",
              "leftValue": "={{$json.notify}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-notify-1",
      "name": "Should Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1450,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{$env.TELEGRAM_ALERT_CHAT_ID}}"
            },
            {
              "name": "text",
              "value": "={{$json.message}}"
            },
            {
              "name": "parse_mode",
              "value": "Markdown"
            }
          ]
        }
      },
      "id": "send-telegram-1",
      "name": "Send Autopay Failure Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1650,
        160
      ]
    }
  ],
  "connections": {
    "8:00 AM Weekdays": {
      "main": [
        [
          {
            "node": "Get Issued Invoices",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get Partial Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Issued Invoices": {
      "main": [
        [
          {
            "node": "Select Due Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Partial Invoices": {
      "main": [
        [
          {
            "node": "Select Due Invoices",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Select Due Invoices": {
      "main": [
        [
          {
            "node": "Has Due Invoice?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Due Invoice?": {
      "main": [
        [
          {
            "node": "Run Invoice Autopay",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Run Invoice Autopay": {
      "main": [
        [
          {
            "node": "Summarize Autopay Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize Autopay Results": {
      "main": [
        [
          {
            "node": "Should Notify?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Notify?": {
      "main": [
        [
          {
            "node": "Send Autopay Failure Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "callerPolicy": "workflowsFromSameFolder"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "1"
}
