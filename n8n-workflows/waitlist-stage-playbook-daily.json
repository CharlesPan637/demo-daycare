    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.results || [];\nconst isoNow = new Date().toISOString();\nconst byTrigger = {high_risk: 0, medium_risk: 0, low_risk: 0};\nfor (const row of rows) {\n  const risk = Number(row.retention_risk_score || 0);\n  if (risk >= 70) byTrigger.high_risk += 1;\n  else if (risk >= 40) byTrigger.medium_risk += 1;\n  else byTrigger.low_risk += 1;\n}\n\nif (!rows.length) {\n  const heartbeat = {\n    workflow_key: 'waitlist_stage_playbook_daily',\n    workflow_name: 'Waitlist Stage Playbook — 10:30AM Weekdays',\n    status: 'success',\n    ran_at: isoNow,\n    error: ''\n  };\n  return [{json: {notify: false, message: '✅ Waitlist stage playbook: no stage actions due today.', summary: {actions_due: 0, by_trigger: byTrigger}, actions: [], heartbeat}}];\n}\n\nconst priorityOrder = {high_risk_recovery: 0, medium_risk_nudge: 1, offer_close_sequence: 2, tour_confirm_sequence: 3, nurture_low_risk: 4};\nconst sorted = [...rows].sort((a, b) => (priorityOrder[a.action_key] ?? 9) - (priorityOrder[b.action_key] ?? 9));\n\nlet msg = '🧭 *Waitlist Stage Playbook*\\n\\n';\nmsg += `Actions due: ${sorted.length}\\n`;\nmsg += `Risk bands — high: ${byTrigger.high_risk}, medium: ${byTrigger.medium_risk}, low: ${byTrigger.low_risk}\\n\\n`;\nfor (const row of sorted.slice(0, 20)) {\n  const badge = row.retention_risk_score >= 70 ? '🔴' : (row.retention_risk_score >= 40 ? '🟠' : '🟢');\n  msg += `${badge} #${row.id} | ${row.status} | ${row.action_key}\\n`;\n  msg += `SLA ${row.follow_up_sla_hours}h | next: ${row.next_follow_up_at}\\n\\n`;\n}\n\nconst heartbeat = {\n  workflow_key: 'waitlist_stage_playbook_daily',\n  workflow_name: 'Waitlist Stage Playbook — 10:30AM Weekdays',\n  status: 'success',\n  ran_at: isoNow,\n  error: `actions=${sorted.length};high_risk=${byTrigger.high_risk};medium_risk=${byTrigger.medium_risk};low_risk=${byTrigger.low_risk}`\n};\n\nconst actions = sorted.map((row) => ({\n  entry_id: row.id,\n  action_key: row.action_key,\n  patch: {\n    escalate: row.action_key === 'high_risk_recovery',\n    escalation_reason: row.action_key === 'high_risk_recovery' ? 'retention_risk_high' : '',\n    nudge_sent: true,\n    follow_up_sla_hours: row.follow_up_sla_hours,\n    next_follow_up_at: row.next_follow_up_at,\n  }\n}));\n\nreturn [{json: {notify: true, message: msg, summary: {actions_due: sorted.length, by_trigger: byTrigger}, actions, heartbeat}}];"
      },
      "id": "build-playbook-1",
      "name": "Build Stage Playbook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
